# erxes BalanceEd environment

# Port for the plugin GraphQL/API server (standalone demo mode)
PORT=3300

# MongoDB connection used when deployed inside erxes (mongoose models).
# Not used in standalone mode — the standalone app stores everything in SQLite.
MONGO_URL=

# SQLite database file for standalone mode. Defaults to ./data/balanceed.db
# relative to the project root; the folder is created on first start and the
# demo class is seeded only when the students table is empty.
# DB_PATH=./data/balanceed.db

# --- Gemma AI (Google AI Studio) ---
# Get a key at https://aistudio.google.com/apikey
# Without a key the plugin uses its built-in deterministic analytics engine
# (same output shape, heuristic scoring + templated Mongolian summaries).
GOOGLE_AI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
