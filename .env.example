# BalanceEd environment — copy to .env and edit. Every value has a working default.

# GraphQL/API server port. The Vite dev server proxies /graphql to this.
PORT=3300

# SQLite database file. Defaults to ./data/balanceed.db relative to the project
# root; the folder is created on first start and the demo class is seeded only
# when the students table is empty.
# DB_PATH=./data/balanceed.db

# Set to 1 behind HTTPS so the session cookie is marked Secure.
# COOKIE_SECURE=1

# --- Gemma AI (Google AI Studio) ---
# Get a key at https://aistudio.google.com/apikey
# Without a key the app scores workload locally and writes the summaries from
# templates, so everything still runs offline.
GOOGLE_AI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
